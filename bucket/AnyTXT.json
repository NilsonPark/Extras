{
    "version": "1.3.2477",
    "description": "A local document search application",
    "homepage": "https://anytxt.net/",
    "license": "Freeware",
    "url": "https://sourceforge.net/projects/anytxt/files/Anytxt_1.3.2477_Windows_X86_64.exe/download",
    "hash": "152248bf85c88eb0b26160bb88ec9fabefb5af280a2bc5770ce86e1ee14be3fd",
    "installer": {
        "args": [
            "/verysilent",
            "/dir=\"$dir\""
        ],
        "script": "sudo taskkill /F /IM ATService.exe | Out-Null"
    },
    "bin": "ATGUI.exe",
    "shortcuts": [
        [
            "ATGUI.exe",
            "AnyTXT"
        ]
    ],
    "persist": "config.db",
    "post_install": "Remove-Item \"$Env:Public\\Desktop\\AnyTXT*.lnk\"",
    "uninstaller": {
        "file": "unins000.exe",
        "args": "/verysilent"
    },
    "checkver": {
        "url": "https://anytxt.net/download/",
        "regex": "Anytxt_([\\d.]+)_Windows_X86_64\\.exe/download"
    },
    "autoupdate": {
        "url": "https://sourceforge.net/projects/anytxt/files/Anytxt_$version_Windows_X86_64.exe/download"
    }
}
